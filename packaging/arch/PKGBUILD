# Maintainer: Aamir Manisa <tallowteam@proton.me>
#
# tallowx is one Tallow source file compiled by the Tallow engine. The engine is
# a hard build-time AND run-time dependency: building shells out to clang, and
# the resulting binary links the engine's runtime archive, which is why
# libtallow.a must be present next to the `tallow` binary at build time.
#
# The engine is not in the official repos and not in AUR; install it first with
# the upstream installer (see README.md). makepkg will refuse without it, which
# is the correct behaviour — a silent build failure here would be worse.

pkgname=tallowx
pkgver=0.2.0
pkgrel=1
pkgdesc="Verified copy/move for local and mounted storage, written entirely in Tallow"
arch=('x86_64' 'aarch64')
url="https://github.com/aamirmanisa/Tallow-Copy"
license=('MIT')
depends=('clang' 'xz' 'bzip2')
makedepends=('clang')
# Deliberately not listed in depends: the engine has no package. This is a
# documented precondition, checked in prepare().
# The repository carries no release tag yet, so this fetches a pinned commit
# tarball rather than a tag that returns 404. Replace $_commit and the checksum
# together when a v$pkgver tag is cut — `updpkgsums` will do it in one step.
_commit=2e484237f80aa175d0f53e2f7f1a0b97c98e3044
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('e68b42fd9ec91237c8164b69b9f535a354352eacd1ca19ce6a6d2417e324b209')

prepare() {
  cd "Tallow-Copy-$_commit"
  if ! command -v tallow >/dev/null 2>&1; then
    echo "ERROR: the Tallow engine is not on PATH." >&2
    echo "The engine lives in the PRIVATE repository aamirmanisa/tallowsphere;" >&2
    echo "an anonymous raw.githubusercontent.com fetch returns 404." >&2
    echo "Build it from a pinned commit with an authenticated clone, then:" >&2
    echo "  cd tallowsphere && cargo build --locked --release --bin tallow --lib" >&2
    echo "  install -m755 target/release/tallow /usr/local/bin/tallow" >&2
    echo "  install -m644 target/release/libtallow.a /usr/local/bin/libtallow.a" >&2
    exit 1
  fi
  if ! command -v clang >/dev/null 2>&1; then
    echo "ERROR: clang is required — the engine shells out to it to compile." >&2
    exit 1
  fi
}

build() {
  cd "Tallow-Copy-$_commit"
  # Build in a subdirectory: `tallow build` writes the executable next to the
  # source, and the repo root already has a `tallowx` launcher script that must
  # not be overwritten by a 110 MB ELF.
  mkdir -p build
  cp tallowx.tl build/
  ( cd build && tallow build tallowx.tl --release )
  ./build/tallowx --help >/dev/null || {
    echo "ERROR: the built binary does not run" >&2
    exit 1
  }
}

check() {
  cd "Tallow-Copy-$_commit"
  # The interpreter suite needs no native build; the native suite rebuilds the
  # binary and exercises --delete, --checksum and --resume end to end.
  bash tests/smoke.sh
  bash tests/native.sh
}

package() {
  cd "Tallow-Copy-$_commit"
  install -Dm755 build/tallowx "$pkgdir/usr/bin/tallowx"
  install -Dm644 tallowx.tl      "$pkgdir/usr/share/tallowx/tallowx.tl"
  install -Dm644 README.md       "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE         "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
